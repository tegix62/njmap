name: Port Authority alert log

# Every few hours: read the Port Authority's bridge & tunnel alerts and add the Lincoln Tunnel, Holland Tunnel
# and George Washington Bridge ones to data/advisories-log.json (see tools/fetch_advisories.py).
on:
  schedule:
    - cron: '17 */3 * * *'
  workflow_dispatch: {}

permissions:
  contents: write

concurrency:
  group: advisories
  cancel-in-progress: false

jobs:
  log:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: main
      - name: Fetch the alerts
        run: python3 -I tools/fetch_advisories.py
      - name: Commit if anything changed
        run: |
          if git diff --quiet -- data/advisories-log.json data/advisories-summary.json; then
            echo "no new alerts"
          else
            git config user.name "advisory-log"
            git config user.email "advisory-log@users.noreply.github.com"
            git add data/advisories-log.json data/advisories-summary.json
            git commit -m "Port Authority alert log: new alerts"
            git push origin HEAD:main
          fi
